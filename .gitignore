# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Dependencies (this project has none, but never commit them if added)
node_modules/
.pnp
.pnp.js

# Build output (this site is served from the repo root; nothing is generated
# into a build dir, but these are excluded in case a bundler is added later)
build/
dist/
.cache/
.parcel-cache/
.output/

# Environment / secrets - NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*credentials*
*secret*

# Platform
.vercel
.netlify

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
